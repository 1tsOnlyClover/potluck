<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Asset - Potluck</title>
  <link rel="stylesheet" href="/css/site.css">
</head>

<body class="maker-page" data-user-name="<%= userName %>">
  <%- include('partials/nav') %>
    <header>
      <button id="asset-title" class="asset-title" type="button" aria-label="Rename asset">New Asset</button>
      <form id="rename-form" class="asset-rename" hidden>
        <label for="asset-name">Asset name</label>
        <input id="asset-name" name="assetName" maxlength="60" required>
        <button type="submit">Rename</button>
        <button id="cancel-rename" type="button">Cancel</button>
      </form>
    </header>
    <div class="asset-actions" aria-label="Asset actions">
      <button id="save-asset" type="button">Save Asset</button>
      <button id="load-asset" type="button">Load Asset</button>
    </div>
    <p id="asset-status" class="asset-status" role="status" aria-live="polite"></p>
    <dialog id="load-asset-dialog" class="load-asset-dialog">
      <form id="load-asset-form">
        <h2>Load a saved asset</h2>
        <label for="saved-asset-select">Choose an asset</label>
        <select id="saved-asset-select" required></select>
        <div class="load-asset-actions">
          <button type="submit">Load Asset</button>
          <button id="cancel-load" type="button">Cancel</button>
        </div>
      </form>
    </dialog>
    <script type="module" src="/js/modeller.js"></script>
</body>

</html>