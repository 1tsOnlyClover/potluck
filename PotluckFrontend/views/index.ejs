<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POTLUCK</title>
  </head>
  <body>
    <div class="login-signup">
      <p>Back for more? Log in!</p>
      <button onclick="logIn()">Log in</button>
      <p>New here? Join the Potluck!</p>
      <button onclick="signUp()">Sign up</button>
      <!-- when clicked the buttons take to login or signup page -->
    </div>
    <script>
      function logIn() {
        window.location.href = '/login';
      }
      function signUp() {
        window.location.href = '/signup';
      }
    </script>
  </body>
</html>